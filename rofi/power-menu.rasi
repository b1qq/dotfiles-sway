* {
    background-color: #1a1a1a;
    text-color:       #a6adc8;
    border-color:     #3a0404;
    font: "Noto Sans 14";
}

window {
    width:        320px;
    border:       2px;
    border-color: #3a0404;
    border-radius: 8px;
    padding:      12px;
}

inputbar {
    enabled: false;
}

listview {
    lines:    5;
    spacing:  6px;
    padding:  6px;
}

element {
    padding:      10px;
    border-radius: 6px;
}

element selected {
    background-color: #3a0404;
    text-color:       #ffffff;
}
