general {
    colors = true
    interval = 1
    output_format = "i3bar"
}

order += "wireless _first_"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "battery all"
order += "volume master"
order += "tztime local"

wireless _first_ {
    format_up = " W: %quality %essid %ip "
    format_down = " W: down "
}

cpu_usage {
    format = " CPU %usage "
}

memory {
    format = " MEM %used "
}

disk "/" {
    format = " / %avail "
}

battery all {
    format = "%status %percentage"
}

volume master {
    format = " VOL %volume "
    format_muted = " VOL muted "
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

tztime local {
    format = " %a %d %b  %H:%M:%S "
}
